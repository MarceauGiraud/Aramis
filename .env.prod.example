# =============================================================================
# Aramis Production Environment
# Copy to .env.prod and fill in your values
# =============================================================================

# Database (Supabase)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Redis (managed by docker-compose, don't change)
# REDIS_URL is set in docker-compose.prod.yml

# Storage (Supabase S3 or any S3-compatible)
S3_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="recordings"
S3_REGION="eu-west-1"

# Bot Configuration
BOT_NAME="Kasar CRM"
BOT_EMAIL="bot@kasar.email"

# Transcription (Deepgram)
DEEPGRAM_API_KEY="your-deepgram-key"

# AI Summary (Anthropic)
ANTHROPIC_API_KEY="your-anthropic-key"

# Webhooks (optional)
WEBHOOK_SECRET="your-webhook-secret"
