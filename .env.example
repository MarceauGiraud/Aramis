# Database
DATABASE_URL="postgresql://aramis:aramis@localhost:5432/aramis?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Storage (S3-compatible - using MinIO for local dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="recordings"
S3_REGION="us-east-1"

# Auth (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# Google OAuth (for Google Meet)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (for Teams)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Zoom OAuth
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Bot Configuration
BOT_NAME="Aramis Recorder"
BOT_EMAIL="bot@yourdomain.com"
BOT_PASSWORD=""

# Transcription Service (Deepgram recommended)
DEEPGRAM_API_KEY=""

# Alternative: OpenAI Whisper API
OPENAI_API_KEY=""

# Alternative: AssemblyAI
ASSEMBLYAI_API_KEY=""
