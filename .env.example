# ===========================================
# Option A: Local Development (Docker)
# ===========================================
# DATABASE_URL="postgresql://aramis:aramis@localhost:5432/aramis?schema=public"
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"

# ===========================================
# Option B: Supabase (Recommended for production)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/[PROJECT]/settings/database
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Get S3 keys from: Supabase Dashboard > Storage > S3 Access Keys
S3_ENDPOINT="https://[PROJECT-REF].supabase.co/storage/v1/s3"
S3_ACCESS_KEY="your-supabase-s3-access-key"
S3_SECRET_KEY="your-supabase-s3-secret-key"

# ===========================================
# Common settings
# ===========================================
S3_BUCKET="recordings"
S3_REGION="eu-west-1"

# Redis (use Upstash for serverless, or local)
REDIS_URL="redis://localhost:6379"
# For Upstash: REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"

# Auth (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# Google OAuth (for Google Meet)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (for Teams)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Zoom OAuth
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Bot Configuration
BOT_NAME="Aramis Recorder"
BOT_EMAIL="bot@yourdomain.com"
BOT_PASSWORD=""

# Transcription Service (Deepgram recommended)
DEEPGRAM_API_KEY=""

# Alternative: OpenAI Whisper API
OPENAI_API_KEY=""

# Alternative: AssemblyAI
ASSEMBLYAI_API_KEY=""
