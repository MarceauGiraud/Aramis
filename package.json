{
  "name": "aramis",
  "version": "1.0.0",
  "private": true,
  "description": "Meeting Recorder for Zoom, Teams, and Google Meet",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @aramis/database generate",
    "db:push": "pnpm --filter @aramis/database push",
    "db:migrate": "pnpm --filter @aramis/database migrate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
